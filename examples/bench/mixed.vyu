def process(items):
    m = {}
    for item in items:
        k = str(item % 100)
        if m.contains(k):
            m[k] = m[k] + 1
        else:
            m[k] = 1
    return len(m)

total = 0
for i in range(200):
    data = []
    for j in range(200):
        data.append(i * 100 + j)
    total = total + process(data)
print(total)