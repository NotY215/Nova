    %t33 =w ceql %t32, 0
    %t34 =l extsw %t33
    %t35 =w cnel %t34, 0
    jnz %t35, @if_then_20, @if_next_21
@if_then_20
    jmp @for_next_12
@if_next_21
@if_end_19
    %t36 =l loadl %vn_slot
