class Point:
    x: int
    y: int

    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y

    def add(self, other: Point) -> None:
        self.x = self.x + other.x
        self.y = self.y + other.y

total = 0
for i in range(5000000):
    a = Point(i, i + 1)
    b = Point(1, 1)
    a.add(b)
    total = total + a.x + a.y
print(total)