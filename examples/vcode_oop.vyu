# 7E-2 + 7E-3 test.

class Point:
    x: int
    y: int
    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y
    def mag_sq(self) -> int:
        return self.x * self.x + self.y * self.y

p = Point(3, 4)
print(p.x)
print(p.y)
print(p.mag_sq())

print("---")

class Animal:
    name: str
    def __init__(self, name: str) -> None:
        self.name = name
    def speak(self) -> str:
        return self.name + " makes a sound"

class Dog(Animal):
    def speak(self) -> str:
        return self.name + " says woof"

d = Dog("Rex")
print(d.speak())

print("---")

