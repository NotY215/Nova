    storel %t15, %vi_slot
    jmp @for_cond_6
@for_cond_6
    %t16 =l loadl %vi_slot
    %t17 =w csltl %t16, 10
    jnz %t17, @for_body_7, @for_end_9
@for_end_9
    %t18 =l loadl %vtotal_slot
    call $vayu_print_int_noln(l %t18)
    call $vayu_print_ln()
