function l $vayu_fn_add(l %p_a, l %p_b) {
@start
    %a_slot =l alloc8 8
    storel %p_a, %a_slot
    %b_slot =l alloc8 8
    storel %p_b, %b_slot
    %t0 =l loadl %a_slot
    %t1 =l loadl %b_slot
    %t2 =l add %t0, %t1
    ret %t2
}

function l $vayu_fn_fact(l %p_n) {
@start
    %n_slot =l alloc8 8
    storel %p_n, %n_slot
    %t0 =l loadl %n_slot
    %t1 =w cslel %t0, 1
    %t2 =l extsw %t1
    %t3 =w cnel %t2, 0
    jnz %t3, @if_then_1, @if_next_2
@if_then_1
    ret 1
@if_next_2
@if_end_0
    %t4 =l loadl %n_slot
    %t5 =l loadl %n_slot
    %t6 =l sub %t5, 1
    %t7 =l call $vayu_fn_fact(l %t6)
    %t8 =l mul %t4, %t7
    ret %t8
}


