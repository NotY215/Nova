class Point:
    x: int
    y: int
    def __init__(self, x: int, y: int) -> None:
        self.x = x
        self.y = y
    def mag_sq(self) -> int:
        return self.x * self.x + self.y * self.y

total = 0
i = 0
while i < 5000000:
    p = Point(i, i + 1)
    total = total + p.mag_sq()
    i = i + 1
print(total)