class Counter:
    value: int
    total: int
    static count: int = 0
    static capacity: int = 100

    def __init__(self, value: int) -> None:
        self.value = value
        self.total = value * 2
        Counter.count = Counter.count + 1

    def report(self) -> int:
        return self.value + Counter.count

def main() -> None:
    print(Counter.count)
    print(Counter.capacity)
    a = Counter(10)
    b = Counter(20)
    c = Counter(30)
    print(Counter.count)
    print(a.report())
    print(b.report())
    print(c.report())
    Counter.capacity = 200
    print(Counter.capacity)

main()