    %t22 =l loadl %vi_slot
    %t23 =w ceql %t22, 42
    %t24 =l extsw %t23
    %t25 =w cnel %t24, 0
    jnz %t25, @if_then_15, @if_next_16
@if_then_15
    jmp @for_end_13
@if_next_16
    %t26 =l loadl %vi_slot
    %t27 =l call $vayu_mod(l %t26, l 2)
    %t28 =w ceql %t27, 0
    %t29 =l extsw %t28
    %t30 =w cnel %t29, 0
    jnz %t30, @if_then_17, @if_next_18
@if_then_17
