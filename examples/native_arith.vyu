# Phase 6B — arithmetic + comparisons + print(int)
print(1 + 2)
print(10 - 3)
print(4 * 5)
print(7 // 2)
print(7 % 3)
print(-5)
print(100)
print((1 + 2) * 3)

# Phase 6C — variables
a = 10
b = 20
c = a + b
print(c)

a = a + 5
print(a)

# Phase 6C — if/elif/else
x = 7
if x < 0:
    print(-1)
elif x == 0:
    print(0)
elif x < 10:
    print(1)
else:
    print(2)

# Phase 6C — while
i = 5
sum = 0
while i > 0:
    sum = sum + i
    i = i - 1
print(sum)

# Phase 6C — comparisons
print(3 < 5)
print(3 > 5)
print(3 == 3)
print(3 != 4)
print(3 <= 3)
print(5 >= 4)

# Phase 6C — boolean combinators
print(true and true)
print(true and false)
print(true or false)
print(not true)
print(not false)