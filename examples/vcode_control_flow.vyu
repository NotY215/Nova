# Test 7E-1: control flow + functions.
x = 0
while x < 5:
    print(x)
    x = x + 1

print("---")

if x > 3:
    print("big")
else:
    print("small")

print("---")

total = 0
for i in range(10):
    total = total + i
print(total)

print("---")

def add(a, b):
    return a + b

print(add(3, 4))
print(add(10, 20))

def fact(n):
    if n <= 1:
        return 1
    return n * fact(n - 1)

print(fact(5))

# break / continue
n = 0
for i in range(100):
    if i == 42:
        break
    if i % 2 == 0:
        continue
    n = n + 1
print(n)